#compdef thronectl thronectl.exe
# zsh completion for thronectl. Generated by 'thronectl completion zsh'.
# thronectl itself completes: 'thronectl __complete WORD... CURRENT' prints the candidates.

_thronectl() {
    local prog=${(Q)words[1]} line value directive=0 ret=1
    local -a out cands nospace
    [[ $prog == '~/'* ]] && prog=$HOME/${prog#'~/'}
    (( $+commands[$prog] )) || [[ -x $prog ]] || prog=thronectl

    out=("${(@f)$("$prog" __complete "${(@Q)words[2,CURRENT-1]}" "${(Q)PREFIX}" </dev/null 2>/dev/null)}")
    for line in "${out[@]}"; do
        case $line in
            ('') ;;
            (:<->) directive=${line#:} ;;
            (*)
                value=${line%%$'\t'*}
                value=${value//:/\\:}
                if [[ $line == *$'\t'* ]]; then
                    cands+=("$value:${line#*$'\t'}")
                else
                    cands+=("$value")
                fi
                ;;
        esac
    done

    (( directive & 1 )) && nospace=(-S '')
    (( $#cands )) && _describe -t values thronectl cands "${nospace[@]}" && ret=0
    if (( directive & 6 )); then
        # The file is the text after the first = of --key-file=FILE.
        [[ $PREFIX == -*=* ]] && compset -P 1 '*='
        if (( directive & 4 )); then
            _files -/ && ret=0
        else
            _files && ret=0
        fi
    fi
    return ret
}

if [[ $funcstack[1] == _thronectl ]]; then
    _thronectl "$@"
else
    compdef _thronectl thronectl thronectl.exe
fi
