# fish completion for thronectl. Generated by 'thronectl completion fish'.
# thronectl itself completes: 'thronectl __complete WORD... CURRENT' prints the candidates.

function __thronectl_complete
    # -x is fish 4's name for -o.
    set -l tokens (commandline -xpc 2>/dev/null)
    or set tokens (commandline -opc)
    set -l current (commandline -ct)
    set -l prog $tokens[1]
    string match -q -- '~/*' $prog; and set prog $HOME/(string sub -s 3 -- $prog)
    command -q -- $prog; or set prog thronectl

    set -l out ($prog __complete $tokens[2..-1] "$current" </dev/null 2>/dev/null)
    set -l directive 0
    if set -q out[1]; and string match -qr '^:[0-9]+$' -- $out[-1]
        set directive (string sub -s 2 -- $out[-1])
        set -e out[-1]
    end
    for line in $out
        test -n "$line"; and printf '%s\n' $line
    end
    if contains -- $directive 2 3
        if string match -q -- '-*=*' "$current"
            set -l flag (string replace -r '=.*' '=' -- "$current")
            for file in (__fish_complete_path (string replace -r '^[^=]*=' '' -- "$current"))
                printf '%s\n' $flag$file
            end
        else
            __fish_complete_path "$current"
        end
    end
end

complete -c thronectl -f -a '(__thronectl_complete)'
complete -c thronectl.exe -f -a '(__thronectl_complete)'
